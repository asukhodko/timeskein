{
  "name": "timeskein",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "version": "0.1.0",
  "description": "Manual-first, local-first work inventory system",
  "scripts": {
    "dev": "pnpm --filter @timeskein/desktop dev",
    "build": "pnpm --filter @timeskein/desktop build",
    "open:macos-app": "node scripts/open-macos-app.mjs",
    "dogfood:macos": "pnpm build && pnpm open:macos-app",
    "dogfood:finish": "node scripts/dogfood-finish.mjs",
    "dogfood:finish:save": "node scripts/dogfood-finish.mjs --save --soft-fail",
    "dogfood:finish:save:strict": "node scripts/dogfood-finish.mjs --save",
    "dogfood:goal-check": "node scripts/dogfood-goal-check.mjs",
    "dogfood:goal-check:status": "node scripts/dogfood-goal-check.mjs --status",
    "dogfood:continue": "node scripts/dogfood-start.mjs --mode continue",
    "dogfood:metrics": "node scripts/dogfood-metrics.mjs",
    "dogfood:preflight": "node scripts/dogfood-preflight.mjs",
    "dogfood:ready": "node scripts/dogfood-ready.mjs",
    "dogfood:rc-check": "node scripts/dogfood-rc-check.mjs --soft-fail",
    "dogfood:rc-check:save": "node scripts/dogfood-rc-check.mjs --save --soft-fail",
    "dogfood:rc-check:strict": "node scripts/dogfood-rc-check.mjs --strict",
    "dogfood:rc-check:strict:save": "node scripts/dogfood-rc-check.mjs --strict --save",
    "dogfood:reset-db": "node scripts/dogfood-reset-db.mjs",
    "dogfood:report": "node scripts/dogfood-report.mjs",
    "dogfood:start": "node scripts/dogfood-start.mjs",
    "dogfood:start:clean": "node scripts/dogfood-start.mjs --reset-db",
    "dogfood:start:clean:preview": "node scripts/dogfood-start.mjs --reset-db --dry-run --skip-preflight",
    "dogfood:status": "node scripts/dogfood-agent-status.mjs",
    "dogfood:stop-active": "node scripts/dogfood-stop-active.mjs",
    "export:focus-day": "node scripts/export-focus-day.mjs",
    "export:app-events": "node scripts/export-app-events.mjs",
    "roadmap:validate": "PYTHONPATH=tools/opskarta python3 -m specs.v3.tools.cli validate plans/timeskein/*.plan.yaml",
    "mock-server": "pnpm --filter @timeskein/mock-server start",
    "smoke:focus-api": "node scripts/smoke-focus-api.mjs",
    "smoke:inventory-modes": "tsx --test scripts/smoke-inventory-modes.test.ts",
    "smoke:timestamped-event-entry": "tsx --test scripts/smoke-timestamped-event-entry.test.ts",
    "smoke:active-focus-journal": "tsx --test scripts/smoke-active-focus-journal.test.ts",
    "smoke:day-closure": "tsx --test scripts/smoke-day-closure.test.ts",
    "smoke:day-review-copy": "tsx --test scripts/smoke-day-review-copy.test.ts",
    "smoke:corrections-api": "node scripts/smoke-corrections-api.mjs",
    "smoke:capture-api": "node scripts/smoke-capture-api.mjs",
    "smoke:mock-api": "node scripts/smoke-mock-api.mjs",
    "smoke:macos-app": "node scripts/smoke-macos-app.mjs",
    "smoke:open-macos-app": "node scripts/smoke-open-macos-app.mjs",
    "smoke:export-focus-day": "node scripts/smoke-export-focus-day.mjs",
    "smoke:dogfood-report": "node scripts/smoke-dogfood-report.mjs",
    "smoke:dogfood-finish": "node scripts/smoke-dogfood-finish.mjs",
    "smoke:dogfood-docs": "node scripts/smoke-dogfood-docs.mjs",
    "smoke:dogfood-goal-check": "node scripts/smoke-dogfood-goal-check.mjs",
    "smoke:dogfood-status": "node scripts/smoke-dogfood-agent-status.mjs",
    "smoke:dogfood-ready": "node scripts/smoke-dogfood-ready.mjs",
    "smoke:dogfood-rc-check": "node scripts/smoke-dogfood-rc-check.mjs",
    "smoke:dogfood-reset-db": "node scripts/smoke-dogfood-reset-db.mjs",
    "smoke:dogfood-start": "node scripts/smoke-dogfood-start.mjs",
    "smoke:dogfood-stop-active": "node scripts/smoke-dogfood-stop-active.mjs",
    "smoke:app-events": "node scripts/smoke-app-events.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "node scripts/test-suite.mjs",
    "test:full": "pnpm dogfood:preflight",
    "smoke:day-events-api": "node scripts/smoke-day-events-api.mjs"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  }
}
